# ================================================
# GitHub 커밋 제외 - 전자정부프레임워크 프로젝트
# ================================================

# 빌드 디렉토리
/target/
/build/
/dist/

# Go 빌드 산출물
h100_module_c/h100_module_c
h100_module_d/h100_module_d
h100_module_c/vendor/
h100_module_d/vendor/

# IDE 설정(eclipse뿐만 아니라 VSCode, IntelliJ도 포함)
.classpath
.project
.settings/
.idea/          # IntelliJ
*.iml           # IntelliJ
.vscode/        # VS Code

# 개발 PC 전용 설정(비밀 포함) — 템플릿(.example)만 git 으로 관리한다
/config/local/*.properties

# 로컬 실행용 설정(비밀·서버 정보 포함) — 템플릿(.example)만 git 으로 관리한다
/h100_module_c/.env
/h100_module_d/.env
/h100_module_c/config/database.yml

# 로그 및 임시파일
.log
logs/
.DS_Store
*.tmp
*.swp

# 백업·압축 파일
*.zip
*.tar.gz
*.bak
*.backup

# Eclipse 서버 설정 (Tomcat 로컬서버 등)
.metadata/
wtpwebapps/

# Claude Code 개인 설정 (로컬 전용)
.claude/settings.local.json

# 디바이스와 송수신을 위한 테스트 코드(운영·Git 추적 제외)
H100_system/

# SSL 인증서·개인 키
*.key
*.pem
*.crt
*.p12
*.pfx
ssl/
h100_module_c/ssl/
h100_module_d/ssl/

# 환경 변수·비밀 정보
.env
.env.local
.env.*.local
h100_module_c/.env
h100_module_d/.env

# Local runtime configuration and temporary verification artifacts
/tmp/
/ops/local/

# Local-only working material
잡일/

# Playwright MCP local artifacts
.playwright-mcp/
playwright-mcp/

# 서버 배포 키트(ops/server-kit)의 서버 고유 파일 — 키트 스크립트/예시만 git 으로 관리한다
ops/server-kit/**/migration.conf
ops/server-kit/**/.env
ops/server-kit/**/.env.bak-*
ops/server-kit/**/*.bak-*
ops/server-kit/**/*.tar.gz
ops/server-kit/**/*.war
ops/server-kit/**/deploy-history.log
ops/server-kit/**/*.sql
ops/server-kit/**/*.sql.gz
