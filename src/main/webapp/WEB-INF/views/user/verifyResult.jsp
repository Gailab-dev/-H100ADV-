<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
<script>
  function closeWindow(){
    window.close();
    alert("이 창을 닫고 회원가입 화면으로 돌아가주세요.");
  }
</script>
</head>
<body>
	<button type="button" onclick="closeWindow()">창 닫기</button>
</body>
</html>