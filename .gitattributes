# 줄바꿈(EOL) 정규화 — 2026-07-22
#  배경: 윈도우에서 작업한 파일이 리눅스 디바이스로 넘어가며 CRLF(\r\n)가 되어
#        `./start.sh` 실행 시 `/bin/bash^M: 잘못된 인터프리터` 오류가 발생했고,
#        .env 의 경우 값 끝에 \r 이 붙어 인증서 경로를 못 찾아 module_d 가 조용히 종료되는 문제가 있었음.
#  조치: 리눅스에서 실행·해석되는 파일은 체크아웃 시 항상 LF 로 고정한다.

# 기본: Git 이 텍스트/바이너리를 자동 판별
*               text=auto

# ===== 리눅스에서 실행/해석되는 파일 — 반드시 LF =====
*.sh            text eol=lf
.env            text eol=lf
.env.*          text eol=lf
*.env           text eol=lf
Makefile        text eol=lf
*.service       text eol=lf

# Go 소스도 LF 고정(gofmt 기준)
*.go            text eol=lf
go.mod          text eol=lf
go.sum          text eol=lf

# ===== 윈도우 전용 스크립트는 CRLF 유지 =====
*.bat           text eol=crlf
*.cmd           text eol=crlf

# ===== 바이너리(줄바꿈 변환 금지) =====
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.svg           text
*.pdf           binary
*.zip           binary
*.jar           binary
*.war           binary
*.wav           binary
*.mp3           binary
*.mp4           binary
*.ts            binary
*.enc           binary
*.pem           text eol=lf
