# 로컬 실행용 설정 템플릿(값 없음). 같은 폴더에 .env 로 복사해 <...> 를 채워 쓴다. 실제 .env 는 .gitignore 대상이며 커밋하지 않는다.
PORT=8087
# 장비 주도 파일 전송 스케줄러 시각(초 분 시 일 월 요일, 6칸). 해석 기준 시간대는 KST(Asia/Seoul).
# FILE_SEND_SCHEDULER_ENABLED=false 로 스케줄러를 끄면 이 값은 사용하지 않는다(비워도 기동한다).
FILE_SEND_SCH_TIME="0 34 14 * * *"

HLS_DIR=./hls

# 카메라 rtsp URL
RTSP_URL=rtsp://<계정>:<비밀번호>@<카메라 IP>:<포트>/<경로>
FFMPEG_PATH=ffmpeg
SEGMENT_TIME=3

# ===== 실시간 영상 시청 정책(38번) — 아래는 모두 선택. 없거나 잘못되면 코드 기본값을 쓴다 =====
# 시청 중 .m3u8/.ts 요청(또는 heartbeat)이 이 시간(초) 동안 없으면 시청 점유를 풀고 ffmpeg 를 종료한다. (기본 20)
#VIEWER_IDLE_TIMEOUT_SEC=20
# 시청자가 end 한 뒤 ffmpeg 를 바로 끄지 않고 기다리는 시간(초). 이 안에 start 가 다시 오면 종료를 취소한다. (기본 15, 0=즉시 종료)
#STREAM_END_GRACE_SEC=15
# start 직후 이 시간(밀리초) 안에 ffmpeg 가 죽으면 start 를 실패(500 FFMPEG_FAILED)로 응답한다. (기본 1500, 0=검사 안 함)
#FFMPEG_START_CHECK_MS=1500
# ffmpeg 를 Kill 한 뒤 종료(회수)를 기다리는 시간(초). (기본 5)
#FFMPEG_STOP_WAIT_SEC=5
# ffmpeg 진행 상태(fps/speed/dup/drop)를 로그로 남기는 간격(초). 0 이면 남기지 않는다. (기본 10)
#FFMPEG_STATS_LOG_SEC=10
# ※ 탭 숨김 유예(기본 30초)는 브라우저(웹) 쪽 설정이다. 이 값보다 VIEWER_IDLE_TIMEOUT_SEC 가 짧으면
#    탭을 숨긴 동안 점유가 풀릴 수 있으므로, 웹이 heartbeat 를 보내지 않는다면 IDLE 값을 탭 숨김 유예보다 길게 둔다.

# 이미지, 영상, 음성 파일 전송시 파일 저장 경로
FILE_PATH=<디바이스 미디어 폴더 절대경로>

# ===== 파일 전송(39번) — 아래는 모두 선택. 없으면 코드 기본값 =====
# 장비 주도 전송 스케줄러 사용 여부. 기본 true(기존 동작). 서버 주도 백업으로 전환해 이중 전송을 막으려면 false.
# false 여도 /fileSend(서버가 요청하는 PULL)는 그대로 동작한다.
#FILE_SEND_SCHEDULER_ENABLED=true
# /fileSend(수동·PULL) 전송 1건의 전체 제한 시간(초). 서버 수신 응답까지 포함. (기본 120)
#FILE_SEND_TIMEOUT_SEC=120
# 스케줄러 전송 1건의 전체 제한 시간(초). 대용량 영상 고려. (기본 600)
#FILE_SEND_SCHEDULER_TIMEOUT_SEC=600

# 이미지, 영상, 음성 파일 전송시 웹 서버 IP와 포트
#클라우드
# CLOUD_RECEIVE_IP=<서버 IP>:<포트>
# 개발
CLOUD_RECEIVE_IP=<서버 IP>:<포트>

# ssl 키 경로
TLS_CERT_FILE=<인증서 파일 경로>
TLS_KEY_FILE=<개인키 파일 경로>


# (22번) module_d -> module_c 파일 전송 시 서버 인증서 검증에 쓰는 내부 CA 인증서(21번에서 발급)
# InsecureSkipVerify:true 를 대체 — 미설정/로드 실패 시 전송 중단(fail-closed)
CA_CERT_FILE=<CA 인증서 파일 경로>

# HMAC 인증키
DEVICE_HMAC_KEY=<이 디바이스의 64hex 키>

# device serial number
# cat /proc/device-tree/serial-number
DEVICE_SERIAL=<13자리 시리얼>

# ROI 설정(웹 ROI 화면 연동). 값은 경로뿐이며 비밀이 아니다.
# 경로 계약(디바이스 담당자 안내 2026-10-28): rois.json = ~/H100/system/rois.json, 스냅샷 폴더 = ~/H100/output/roi_snapshot
# ROI_FILE_PATH 가 없으면 ROI_get / ROI_receive 가 503(NOT_CONFIGURED) 으로 응답한다.
ROI_FILE_PATH=/home/<계정>/H100/system/rois.json
# 스냅샷 파일: 카메라마다 Cam1.png / Cam2.png 를 둔다(PNG 우선, 해당 카메라의 .png 가 없을 때만 .jpg 사용). PNG/JPEG 모두 가능, 서버 기대 크기는 1920x1080.
# ROI_SNAPSHOT_URL 과 ROI_SNAPSHOT_DIR 중 하나는 필수이며 둘 다 있으면 URL 이 우선한다. 둘 다 없으면 ROI_snapshot 이 503.
ROI_SNAPSHOT_DIR=/home/<계정>/H100/output/roi_snapshot
# 로컬 Python 이 스냅샷을 공급할 때만 사용(GET ?camera=Cam1 / Cam2 → PNG 또는 JPEG). 사용하지 않으면 비워 둔다.
#ROI_SNAPSHOT_URL=
