# 로컬 실행용 설정 템플릿(값 없음). 같은 폴더에 .env 로 복사해 <...> 를 채워 쓴다. 실제 .env 는 .gitignore 대상이며 커밋하지 않는다.
PORT=8087
FILE_SEND_SCH_TIME="0 34 14 * * *"

HLS_DIR=./hls

# 카메라 rtsp URL
RTSP_URL=rtsp://<계정>:<비밀번호>@<카메라 IP>:<포트>/<경로>
FFMPEG_PATH=ffmpeg
SEGMENT_TIME=3

# 이미지, 영상, 음성 파일 전송시 파일 저장 경로
FILE_PATH=<디바이스 미디어 폴더 절대경로>

# 이미지, 영상, 음성 파일 전송시 웹 서버 IP와 포트
#클라우드
# CLOUD_RECEIVE_IP=<서버 IP>:<포트>
# 개발
CLOUD_RECEIVE_IP=<서버 IP>:<포트>

# ssl 키 경로
TLS_CERT_FILE=<인증서 파일 경로>
TLS_KEY_FILE=<개인키 파일 경로>


# (22번) module_d -> module_c 파일 전송 시 서버 인증서 검증에 쓰는 내부 CA 인증서(21번에서 발급)
# InsecureSkipVerify:true 를 대체 — 미설정/로드 실패 시 전송 중단(fail-closed)
CA_CERT_FILE=<CA 인증서 파일 경로>

# HMAC 인증키
DEVICE_HMAC_KEY=<이 디바이스의 64hex 키>

# device serial number
# cat /proc/device-tree/serial-number
DEVICE_SERIAL=<13자리 시리얼>
