# 로컬 실행용 설정 템플릿(값 없음). 같은 폴더에 .env 로 복사해 <...> 를 채워 쓴다. 실제 .env 는 .gitignore 대상이며 커밋하지 않는다.
PORT=8087
FILE_SEND_SCH_TIME="0 34 14 * * *"

HLS_DIR=./hls

# 카메라 rtsp URL
RTSP_URL=rtsp://<계정>:<비밀번호>@<카메라 IP>:<포트>/<경로>
FFMPEG_PATH=ffmpeg
SEGMENT_TIME=3

# 이미지, 영상, 음성 파일 전송시 파일 저장 경로
FILE_PATH=<디바이스 미디어 폴더 절대경로>

# 이미지, 영상, 음성 파일 전송시 웹 서버 IP와 포트
#클라우드
# CLOUD_RECEIVE_IP=<서버 IP>:<포트>
# 개발
CLOUD_RECEIVE_IP=<서버 IP>:<포트>

# ssl 키 경로
TLS_CERT_FILE=<인증서 파일 경로>
TLS_KEY_FILE=<개인키 파일 경로>


# (22번) module_d -> module_c 파일 전송 시 서버 인증서 검증에 쓰는 내부 CA 인증서(21번에서 발급)
# InsecureSkipVerify:true 를 대체 — 미설정/로드 실패 시 전송 중단(fail-closed)
CA_CERT_FILE=<CA 인증서 파일 경로>

# HMAC 인증키
DEVICE_HMAC_KEY=<이 디바이스의 64hex 키>

# device serial number
# cat /proc/device-tree/serial-number
DEVICE_SERIAL=<13자리 시리얼>

# ROI 설정(웹 ROI 화면 연동). 값은 경로뿐이며 비밀이 아니다.
# 경로 계약(디바이스 담당자 안내 2026-10-28): rois.json = ~/H100/system/rois.json, 스냅샷 폴더 = ~/H100/output/roi_snapshot
# ROI_FILE_PATH 가 없으면 ROI_get / ROI_receive 가 503(NOT_CONFIGURED) 으로 응답한다.
ROI_FILE_PATH=/home/<계정>/H100/system/rois.json
# 스냅샷 파일: 카메라마다 Cam1.png / Cam2.png 를 둔다(PNG 우선, 해당 카메라의 .png 가 없을 때만 .jpg 사용). PNG/JPEG 모두 가능, 서버 기대 크기는 1920x1080.
# ROI_SNAPSHOT_URL 과 ROI_SNAPSHOT_DIR 중 하나는 필수이며 둘 다 있으면 URL 이 우선한다. 둘 다 없으면 ROI_snapshot 이 503.
ROI_SNAPSHOT_DIR=/home/<계정>/H100/output/roi_snapshot
# 로컬 Python 이 스냅샷을 공급할 때만 사용(GET ?camera=Cam1 / Cam2 → PNG 또는 JPEG). 사용하지 않으면 비워 둔다.
#ROI_SNAPSHOT_URL=
