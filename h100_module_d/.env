PORT=8087
FILE_SEND_SCH_TIME="0 34 14 * * *"

HLS_DIR=./hls

# 카메라 rtsp URL
RTSP_URL=rtsp://admin:Gailab3883!@192.168.0.101:554/stream1
FFMPEG_PATH=ffmpeg
SEGMENT_TIME=3

# 이미지, 영상, 음성 파일 전송시 파일 저장 경로
FILE_PATH=/home<계정명>/H100/recorded/

# 이미지, 영상, 음성 파일 전송시 웹 서버 IP와 포트
#클라우드
# CLOUD_RECEIVE_IP=114.110.160.12:8089
# 개발
CLOUD_RECEIVE_IP=192.168.0.15:8189

# ssl 키 경로
TLS_CERT_FILE=/home/gailab/H100/system/h100_module_d/ssl/device-1420923006558.crt
TLS_KEY_FILE=/home/gailab/H100/system/h100_module_d/ssl/device-1420923006558.key


# (22번) module_d -> module_c 파일 전송 시 서버 인증서 검증에 쓰는 내부 CA 인증서(21번에서 발급)
# InsecureSkipVerify:true 를 대체 — 미설정/로드 실패 시 전송 중단(fail-closed)
CA_CERT_FILE=/home/<계정명>/H100/system/h100_module_d/ssl/h100-ca.crt

# HMAC 인증키
DEVICE_HMAC_KEY=c78c511b40908cfb4c8dcc326c57872e55194e6be85dd4f46223335c5717dad3

# device serial number
# cat /proc/device-tree/serial-number
DEVICE_SERIAL=1420923006558



