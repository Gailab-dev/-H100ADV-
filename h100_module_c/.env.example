# 로컬 실행용 설정 템플릿(값 없음). 같은 폴더에 .env 로 복사해 <...> 를 채워 쓴다. 실제 .env 는 .gitignore 대상이며 커밋하지 않는다.
PORT=8189

# 파일 수신(/imageFileReceive, /videoFileReceive, /audioFileReceive) 요청 본문 상한(MB). 선택, 기본 512.
# 수신 파일은 HMAC 검증을 위해 메모리에 올라가므로 서버 메모리에 맞게 조정한다.
#FILE_RECEIVE_MAX_MB=512

# 영상, 이미지, 음성 파일 다운로드 경로
# 개발 서버
FILE_UPLOAD_PATH=<미디어 폴더 절대경로>/

# ssl key 위치
TLS_CERT_FILE=<인증서 파일 경로>
TLS_KEY_FILE=<개인키 파일 경로>

# H100_HMAC_KEYS
# 작성예시 : H100_HMAC_KEYS = {"<serialnumber>":"<이 디바이스용 64hex 키>","<serialnumber>":"<이 디바이스용 64hex 키>,..."} 
H100_HMAC_KEYS={"<serialnumber>":"<해당 디바이스의 64hex 키>"}
