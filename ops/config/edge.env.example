# Copy to ops/local/edge.env on the edge host, then replace every site value.
H100_EDGE_BIND_IP=192.0.2.20
H100_EDGE_DATA=/home/gailab/H100_system
H100_EDGE_CERTS=/etc/h100/certs
PORT=8443
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key
HEALTH_TLS_NAME=192.0.2.20
CA_CERT_FILE=/certs/ca.crt
CLOUD_RECEIVE_IP=192.0.2.10:7811
DEVICE_SERIAL=REPLACE_WITH_13_DIGIT_SERIAL
DEVICE_HMAC_KEY=REPLACE_WITH_64_HEX_KEY
H100_AES_KEY=REPLACE_WITH_SAME_64_HEX_KEY_AS_CONTROL_WEB
H100_TRIGGER_TOKEN=REPLACE_WITH_SAME_TRIGGER_TOKEN_AS_CONTROL_WEB
FILE_SEND_SCH_TIME=0 0 2 * * *
FILE_PATH=/data
AUDIO_PATH=/data/voice
HLS_DIR=/hls
FFMPEG_PATH=/usr/bin/ffmpeg
RTSP_URL=rtsp://REPLACE_WITH_CAMERA_ADDRESS
SEGMENT_TIME=1
# --- ROI setting (plan 34). Ask the device team for the real ROI file path before enabling. ---
# The file must be writable by this container; see ops/compose.edge-roi.yml (the /data bind is read-only).
#ROI_FILE_PATH=/roi/roi.json
# Snapshot source: use one of the two (URL wins when both are set). Images may be PNG or JPEG (detected by content);
# the server accepts only 1920x1080.
# ROI_SNAPSHOT_URL is called with GET ?camera=Cam1 / ?camera=Cam2 and must return the image;
# ROI_SNAPSHOT_DIR is a directory holding Cam1.png and Cam2.png (a camera falls back to its .jpg only when its .png is absent).
#ROI_SNAPSHOT_URL=
#ROI_SNAPSHOT_DIR=
