# /opt/h100/migration/migration.conf  (비밀값 금지 — 경로/주소만)
# 이 예시는 "개발서버(192.168.0.115)" 기준 값이다. 사용: cp migration.conf.example migration.conf
# (VM 리허설에서는 SERVER_CERT_IP=127.0.0.1, DEFAULT_ALLOW_CIDR=10.0.2.0/24 로 바꿔 썼다 — 개발서버에는 해당 없음)
# migration.conf 가 없으면 lib.sh 의 기본값(= 아래와 동일)이 쓰이지만, 실행 로그에 기준이 남도록 파일로 두는 것을 권장.
OLD_HOST=192.168.0.15
OLD_USER=dsic
OLD_SSH_PORT=22
OLD_MEDIA_DIR=/home/dsic/Desktop/H100_system

NEW_MEDIA_DIR=/var/lib/h100/media
H100_UID=3100
H100_GID=3100

# 서버 인증서 SAN 기대값. 현재 신 서버 인증서는 192.168.0.115.
# IP 인수(192.168.0.15 승계) 방식이면 SAN 에 .15 를 포함한 새 인증서 발급 후 .15 로 변경.
SERVER_CERT_IP=192.168.0.115

DB_HOST_PORT=3310
EXPECT_DB_SCHEMAS="able_park"

# 8189 접근 허용 목록(한 줄에 IP 또는 CIDR). 미확보(§6-④)이면 LAN 전체로 임시 운영 후 좁힌다.
DEVICE_ALLOW_FILE=/etc/h100/device-allow.list
DEFAULT_ALLOW_CIDR=192.168.0.0/24

# Tomcat 컨텍스트 경로 (구 서버 /gov-disabled-web-adv 와 동일; ROOT 로 바꾸려면 ROOT)
WEB_CONTEXT=gov-disabled-web-adv
